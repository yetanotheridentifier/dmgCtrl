      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Score margin",
          "description": "Player score minus opponent score, including scenario points, for X-Wing games that ended in the app with a result",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "afltq9th19d6ob"
                      },
                      "spec": {
                        "dataset": "iox",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT band AS \"Margin\", COUNT(*) AS games\nFROM (\n  SELECT player_score - opponent_score AS margin,\n    CASE\n      WHEN player_score - opponent_score <= -50 THEN 'lost by 50+'\n      WHEN player_score - opponent_score <= -20 THEN 'lost by 20 to 49'\n      WHEN player_score - opponent_score < 0 THEN 'lost by 1 to 19'\n      WHEN player_score - opponent_score = 0 THEN 'level'\n      WHEN player_score - opponent_score < 20 THEN 'won by 1 to 19'\n      WHEN player_score - opponent_score < 50 THEN 'won by 20 to 49'\n      ELSE 'won by 50+'\n    END AS band\n  FROM events\n  WHERE env = CASE WHEN '$env' LIKE '$%' THEN 'production' ELSE '$env' END\n    AND event = 'game_ended'\n    AND game = 'xwing'\n    AND result IN ('win', 'loss', 'draw')\n    AND $__timeFilter(time)\n) sub\nGROUP BY band\nORDER BY MIN(margin)"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "rowsToFields",
                  "spec": {
                    "options": {
                      "nameField": "Margin",
                      "valueField": "games"
                    }
                  }
                }
              ],
