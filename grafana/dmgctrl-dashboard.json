      "panel-19": {
        "kind": "Panel",
        "spec": {
          "id": 19,
          "title": "Sessions by version",
          "description": "Distinct sessions per build release, newest first: the deploy run number in production, dev-<commit> in development. Every event carries the release of the build that sent it, so a session still on a cached build shows under its old release. 0.0.0 is a build from before the release was recorded.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "afltq9th19d6ob"
                      },
                      "spec": {
                        "dataset": "iox",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT version AS \"Version\", COUNT(DISTINCT \"sessionId\") AS sessions\nFROM events\nWHERE env = CASE WHEN '$env' LIKE '$%' THEN 'production' ELSE '$env' END\n  AND version IS NOT NULL\n  AND $__timeFilter(time)\nGROUP BY version\nORDER BY MAX(time) DESC\nLIMIT 12"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "rowsToFields",
                  "spec": {
                    "options": {
                      "nameField": "Version",
                      "valueField": "sessions"
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "spec": {
              "options": {
                "displayMode": "gradient",
                "orientation": "horizontal",
                "namePlacement": "auto",
                "reduceOptions": {
