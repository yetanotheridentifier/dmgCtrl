      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Sessions by country",
          "description": "Sessions, by the country Cloudflare reports for the request. Darker means more sessions. Countries too small for the world map (for example Malta or Singapore) are counted but not drawn. Development traffic has no country, so this panel is empty for development.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "afltq9th19d6ob"
                      },
                      "spec": {
                        "dataset": "iox",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT country, COUNT(DISTINCT \"sessionId\") AS sessions\nFROM events\nWHERE env = CASE WHEN '$env' LIKE '$%' THEN 'production' ELSE '$env' END\n  AND country IS NOT NULL\n  AND country <> 'unknown'\n  AND $__timeFilter(time)\nGROUP BY country\nORDER BY sessions DESC"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "volkovlabs-echarts-panel",
            "spec": {
              "options": {
                "renderer": "canvas",
                "map": "json",
                "editorMode": "code",
                "editor": {
                  "format": "auto"
                },
                "getOption": "const s = context.panel.data.series[0];\nconst fields = s?.fields ?? [];\nconst codes = fields.find((f) => f.name === 'country')?.values ?? [];\nconst counted = fields.find((f) => f.name !== 'country');\nconst unit = counted?.name ?? 'count';\nconst counts = counted?.values ?? [];\n\n// The world map names countries in English. Intl supplies most of those names from the\n// two-letter code Cloudflare reports; these are the ones where the map's name differs.\nconst ALIASES = {\n  BA: 'Bosnia and Herzegovina',\n  BS: 'The Bahamas',\n  CD: 'Democratic Republic of the Congo',\n  CG: 'Republic of the Congo',\n  CI: 'Ivory Coast',\n  CZ: 'Czech Republic',\n  GW: 'Guinea Bissau',\n  MK: 'Macedonia',\n  MM: 'Myanmar',\n  RS: 'Republic of Serbia',\n  SZ: 'Swaziland',\n  TL: 'East Timor',\n  TR: 'Turkey',\n  TT: 'Trinidad and Tobago',\n  TZ: 'United Republic of Tanzania',\n  US: 'United States of America',\n};\nconst regions = new Intl.DisplayNames(['en'], { type: 'region' });\nconst nameOf = (code) => {\n  if (ALIASES[code]) return ALIASES[code];\n  try {\n    return regions.of(code);\n  } catch {\n    return code;\n  }\n};\n\nconst data = codes.map((code, i) => ({ name: nameOf(code), value: counts[i] }));\nconst max = Math.max(1, ...data.map((d) => d.value));\nconst theme = context.grafana.theme;\n\nreturn {\n  backgroundColor: 'transparent',\n  tooltip: {\n    trigger: 'item',\n    formatter: (p) => `${p.name}: ${Number.isFinite(p.value) ? p.value : 0} ${unit}`,\n  },\n  visualMap: {\n    min: 0,\n    max,\n    left: 'left',\n    bottom: 0,\n    calculable: true,\n    text: [`More ${unit}`, 'Fewer'],\n    inRange: { color: ['#c6dbef', '#08306b'] },\n    textStyle: { color: theme.colors.text.secondary },\n  },\n  series: [\n    {\n      name: unit,\n      type: 'map',\n      map: 'world',\n      // Top and bottom set the map's height to the panel's; ECharts keeps the aspect ratio.\n      top: 8,\n      bottom: 8,\n      roam: true,\n      scaleLimit: { min: 1, max: 12 },\n      itemStyle: {\n        areaColor: theme.colors.background.secondary,\n        borderColor: theme.colors.border.medium,\n      },\n      emphasis: { label: { show: false }, itemStyle: { areaColor: '#f2cc0c' } },\n      select: { disabled: true },\n      data,\n    },\n  ],\n};\n"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Games per session",
          "description": "Distribution of qualifying games (duration > 60s) completed per session",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "afltq9th19d6ob"
                      },
                      "spec": {
                        "dataset": "iox",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT CAST(game_count AS VARCHAR) AS \"Games\", COUNT(*) AS sessions\nFROM (\n  SELECT COUNT(*) AS game_count\n  FROM events\n  WHERE env = CASE WHEN '$env' LIKE '$%' THEN 'production' ELSE '$env' END\n    AND event = 'game_started'\n    AND $__timeFilter(time)\n  GROUP BY \"sessionId\"\n) sub\nGROUP BY game_count\nORDER BY game_count"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "rowsToFields",
                  "spec": {
                    "options": {
                      "nameField": "Games",
                      "valueField": "sessions"
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "13.1.0-25668120414",
            "spec": {
              "options": {
                "displayMode": "gradient",
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false
                },
                "maxVizHeight": 300,
