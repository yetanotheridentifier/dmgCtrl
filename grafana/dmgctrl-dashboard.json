      "panel-18": {
        "kind": "Panel",
        "spec": {
          "id": 18,
          "title": "Settings changes",
          "description": "Changes to general (cross-game) settings in the selected time range",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "afltq9th19d6ob"
                      },
                      "spec": {
                        "dataset": "iox",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT setting, COUNT(*) AS changes\nFROM events\nWHERE env = CASE WHEN '$env' LIKE '$%' THEN 'production' ELSE '$env' END\n  AND event = 'setting_changed'\n  AND setting IN ('enableActionLog', 'enableInitiativeBar')\n  AND $__timeFilter(time)\nGROUP BY setting\nORDER BY changes DESC"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
