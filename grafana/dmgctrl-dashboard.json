      "panel-17": {
        "kind": "Panel",
        "spec": {
          "id": 17,
          "title": "Game selection",
          "description": "Total game sessions by game, selected time range",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "afltq9th19d6ob"
                      },
                      "spec": {
                        "dataset": "iox",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT CASE WHEN game = 'xwing' THEN 'X-Wing' ELSE 'SWU' END AS game, COUNT(*) AS games\nFROM events\nWHERE env = CASE WHEN '$env' LIKE '$%' THEN 'production' ELSE '$env' END\n  AND event = 'game_started'\n  AND $__timeFilter(time)\nGROUP BY 1\nORDER BY games DESC"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "rowsToFields",
                  "spec": {
